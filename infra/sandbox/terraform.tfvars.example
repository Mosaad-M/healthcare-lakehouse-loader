# Copy to terraform.tfvars (git-ignored) and fill in. Terraform refuses any account but this one.
account_id = "123456789012"
profile    = "my-sandbox-profile" # an AWS CLI (SSO) profile for that account
# Cost alerts (optional): budget and anomaly emails. Leave empty for none.
alert_emails       = [] # e.g. ["ops@example.org"]
monthly_budget_usd = 50
